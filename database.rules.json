{
  "rules": {
    ".read": false,
    ".write": false,
    "multiplayer": {
      "rooms": {
        "$room": {
          ".write": "auth != null && ((!data.exists() && newData.child('meta').child('hostUid').val() === auth.uid) || (data.exists() && data.child('meta').child('hostUid').val() === auth.uid))",
          "meta": {
            ".read": "auth != null",
            ".validate": "newData.hasChildren(['hostUid', 'protocolVersion', 'hostName', 'createdAt']) && newData.child('hostUid').isString() && newData.child('hostUid').val() === auth.uid && newData.child('protocolVersion').isNumber() && newData.child('protocolVersion').val() === 4 && newData.child('hostName').isString() && newData.child('hostName').val().length > 0 && newData.child('hostName').val().length <= 48 && newData.child('createdAt').isNumber()",
            "hostUid": { ".validate": "newData.isString()" },
            "protocolVersion": { ".validate": "newData.isNumber()" },
            "hostName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "peers": {
            ".read": "auth != null && root.child('multiplayer').child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              "client": {
                ".write": "auth != null && auth.uid === $uid && root.child('multiplayer').child('rooms').child($room).child('meta').exists()",
                ".validate": "!newData.exists() || (newData.hasChildren(['name', 'platform', 'description', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 48 && newData.child('platform').isString() && newData.child('platform').val().length > 0 && newData.child('platform').val().length <= 32 && newData.child('description').child('type').val() === 'offer' && newData.child('description').child('sdp').isString() && newData.child('description').child('sdp').val().length > 0 && newData.child('description').child('sdp').val().length <= 50000 && newData.child('createdAt').isNumber())",
                "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48" },
                "platform": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
                "description": {
                  ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('type').val() === 'offer' && newData.child('sdp').isString() && newData.child('sdp').val().length > 0 && newData.child('sdp').val().length <= 50000",
                  "type": { ".validate": "newData.val() === 'offer'" },
                  "sdp": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50000" },
                  "$other": { ".validate": false }
                },
                "createdAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              },
              "host": {
                ".validate": "!newData.exists() || ((newData.hasChildren(['description', 'createdAt']) && newData.child('description').child('type').val() === 'answer' && newData.child('description').child('sdp').isString() && newData.child('description').child('sdp').val().length > 0 && newData.child('description').child('sdp').val().length <= 50000 && newData.child('createdAt').isNumber()) || (newData.hasChildren(['error', 'createdAt']) && newData.child('error').val() === 'host-full' && newData.child('createdAt').isNumber()))",
                "description": {
                  ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('type').val() === 'answer' && newData.child('sdp').isString() && newData.child('sdp').val().length > 0 && newData.child('sdp').val().length <= 50000",
                  "type": { ".validate": "newData.val() === 'answer'" },
                  "sdp": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50000" },
                  "$other": { ".validate": false }
                },
                "error": { ".validate": "newData.val() === 'host-full'" },
                "createdAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          }
        }
      }
    }
  }
}
