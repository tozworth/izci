{
  "listen": "127.0.0.1:8787",
  "publicBaseUrl": "https://izci-server.example.com",
  "pathPrefix": "",
  "allowedOrigins": ["https://izci.example.com"],
  "hostKeyFile": "/etc/izci-server/host-key",
  "trustedProxies": [],
  "description": "Example server operator",
  "contact": "admin@example.com",
  "iceUrls": [],
  "relaySecretFile": "",
  "relayCredentialTtl": "10m",
  "maxIcePerConnection": 16,
  "library": {
    "roots": [
      {
        "name": "music",
        "path": "/srv/izci-server/music",
        "include": ["**"],
        "exclude": ["drafts/**", "*.part"]
      },
      { "name": "modules", "path": "/srv/izci-server/modules", "include": ["**/*.mod", "**/*.xm", "**/*.s3m", "**/*.it", "**/*.mo3", "**/*.ahx", "**/*.hvl"] }
    ],
    "scanConcurrency": 8,
    "rescanInterval": "0s"
  },
  "sourceTransfer": {
    "mode": "always",
    "maxBytes": 33554432
  },
  "database": {
    "path": "/var/lib/izci-server/izci-server.db"
  },
  "catalog": {
    "maxItemsPerCollection": 50000,
    "maxTotalItems": 100000
  }
}
