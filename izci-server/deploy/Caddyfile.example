# Example Caddy config: TLS termination in front of izci-server, optionally
# serving the izci frontend from the same origin. Copy to Caddyfile and set
# your hostname.
#
# The /party path is forwarded WITH its prefix: it must match pathPrefix in
# the server config and the path component of publicBaseUrl.
#
# Bare-metal proxy target is 127.0.0.1:8787 below; under Compose use the
# service name (reverse_proxy izci-server:8787).

izci-server.example.com {
	# Optional: serve the izci PWA (npm run build output) alongside the API.
	# root * /srv/izci
	# try_files {path} /index.html
	# file_server

	handle /party/* {
		reverse_proxy 127.0.0.1:8787
	}

	# Liveness probe without the prefix (the versioned API stays under it).
	handle /healthz {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		respond "izci-server" 404
	}
}
