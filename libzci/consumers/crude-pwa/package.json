{
  "name": "crude-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "libzci reference Opus player: shared Rust control/audio WASM and bounded File decode worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/audio-wasm.test.mjs",
    "build:wasm": "python scripts/build-wasm.py",
    "build:codecs": "python ../../scripts/build-browser-codecs.py",
    "test:browser": "node test/browser.mjs",
    "test:callbacks": "node test/callbacks.mjs",
    "test:m1": "node test/m1.mjs",
    "test:m2": "node test/m2.mjs",
    "test:storage": "node test/storage.mjs",
    "test:installed": "node test/installed.mjs",
    "test:webcodecs": "node test/webcodecs.mjs",
    "test:android": "node test/android.mjs",
    "build:modules": "python ../../scripts/build-browser-modules.py"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "playwright": "1.61.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1"
  }
}
