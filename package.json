{
  "name": "izci",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "i18n:extract": "svelte-i18n extract \"src/**/*.svelte\" src/lib/i18n/locales/en.json --overwrite",
    "i18n:sync": "npm run i18n:extract && node scripts/sync-i18n.mjs",
    "i18n:validate": "node scripts/sync-i18n.mjs --check",
    "optional:stems": "node scripts/download-stem-payload.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "hosting:preview": "npm run optional:stems && npm run build && firebase hosting:channel:deploy preview --expires 7d",
    "hosting:deploy": "npm run optional:stems && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.40.2",
    "chiptune3": "^0.8.4",
    "howler": "^2.2.4",
    "onnxruntime-web": "1.27.0",
    "svelte": "^5.38.7",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@tsconfig/svelte": "^5.0.4",
    "@webgpu/types": "0.1.71",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "svelte-i18n": {
      "esbuild": "^0.28.1"
    }
  }
}
