{
  "name": "izci",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sites:build": "npm run build && node scripts/prepare-sites-build.mjs",
    "i18n:extract": "svelte-i18n extract \"src/**/*.svelte\" src/lib/i18n/locales/en.json --overwrite",
    "i18n:sync": "npm run i18n:extract && node scripts/sync-i18n.mjs",
    "i18n:validate": "node scripts/sync-i18n.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:firebase-rules": "firebase emulators:exec --only database --project izci-pwa \"vitest run src/lib/services/multiplayer-database-rules.test.ts\"",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "firebase:deploy:multiplayer": "firebase deploy --only auth,database --project izci-pwa",
    "hosting:preview": "npm run build && firebase hosting:channel:deploy preview --expires 7d --project izci-pwa",
    "hosting:deploy": "npm run build && firebase deploy --only auth,database,hosting --project izci-pwa"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.40.2",
    "@mediabunny/flac-encoder": "^1.52.0",
    "@mediabunny/mp3-encoder": "^1.52.0",
    "chiptune3": "^0.8.4",
    "fflate": "^0.8.3",
    "firebase": "^12.17.0",
    "howler": "^2.2.4",
    "mediabunny": "^1.52.0",
    "svelte": "^5.38.7",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@tsconfig/svelte": "^5.0.4",
    "firebase-tools": "^15.25.1",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1"
  }
}
