{
  "name": "izci",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-multiplayer-protocol.mjs",
    "build": "vite build",
    "desktop:frontend": "node scripts/sync-multiplayer-protocol.mjs && node scripts/sync-desktop-formats.mjs && vite build --mode desktop",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:verify": "node scripts/verify-desktop-build.mjs",
    "sites:build": "npm run build && node scripts/prepare-sites-build.mjs",
    "i18n:extract": "svelte-i18n extract \"src/**/*.svelte\" src/lib/i18n/locales/en.json --overwrite",
    "i18n:sync": "npm run i18n:extract && node scripts/sync-i18n.mjs",
    "i18n:validate": "node scripts/sync-i18n.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fixtures": "vitest run tests/fixtures/corpus.test.mjs",
    "test:quality-tools": "node --test scripts/quality/architecture/*.node-test.mjs",
    "multiplayer:protocol:check": "node scripts/sync-multiplayer-protocol.mjs --check",
    "quality:architecture": "node scripts/quality/architecture/report.mjs",
    "fixtures:generate": "node fixtures/generate.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "hosting:preview": "npm run build && firebase hosting:channel:deploy preview --expires 7d --project izci-pwa",
    "hosting:deploy": "npm run build && firebase deploy --only hosting --project izci-pwa"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.40.2",
    "@mediabunny/flac-encoder": "^1.52.0",
    "@mediabunny/mp3-encoder": "^1.52.0",
    "@tauri-apps/api": "^2.12.0",
    "chiptune3": "^0.8.4",
    "fflate": "^0.8.3",
    "howler": "^2.2.4",
    "mediabunny": "^1.52.0",
    "svelte": "^5.38.7",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@tauri-apps/cli": "^2.12.0",
    "@tsconfig/svelte": "^5.0.4",
    "firebase-tools": "^15.25.1",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1"
  }
}
