{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "izci",
  "version": "0.4.0",
  "identifier": "app.izci.desktop",
  "build": {
    "removeUnusedCommands": true,
    "windows": { "staticVCRuntime": true },
    "beforeBuildCommand": "npm run desktop:frontend",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "izci",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 240,
        "minHeight": 240,
        "decorations": false,
        "visible": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false,
        "backgroundColor": "#18191b"
      },
      {
        "label": "mini-player",
        "create": false,
        "title": "izci Mini player",
        "url": "mini-player.html",
        "width": 320,
        "height": 76,
        "minWidth": 320,
        "minHeight": 76,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false,
        "backgroundColor": "#18191b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob: data: https: http:; font-src 'self' blob: data:; connect-src 'self' ipc: http: https: ws: wss: blob: data:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
